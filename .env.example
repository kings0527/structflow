# Optional StructFlow search providers
# Copy this file to .env and configure only the providers you use.

# Tavily Search API (https://tavily.com)
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# AnySearch API (https://anysearch.com) — complementary search engine
ANYSEARCH_API_KEY=as_sk_your-anysearch-api-key-here
ANYSEARCH_ENDPOINT=https://api.anysearch.com/mcp

# Data Collection
SEARCH_ENABLE_WEB_SEARCH=true
SEARCH_MAX_RESULTS=10
SEARCH_DEPTH=advanced

# Structured market data channel (fetch-market-data, optional)
# Install extras first: pip install -e ".[market-data]"
MARKET_DATA_ENABLED=true
MARKET_DATA_TIMEOUT=20
# Dual-source price cross-validation tolerance (0.005 = 0.5%)
MARKET_DATA_PRICE_TOLERANCE=0.005
MARKET_DATA_LOOKBACK_DAYS=365

# FRED API key (optional; free at https://fred.stlouisfed.org/docs/api/api_key.html)
# Without it the macro (FRED) provider is skipped with a degraded warning.
FRED_API_KEY=

# SEC EDGAR contact identity (required for 13F institutional data,
# e.g. "Jane Doe jane@example.com"; SEC mandates a contact per request).
# Without it the edgar provider is skipped with a degraded warning.
EDGAR_IDENTITY=
